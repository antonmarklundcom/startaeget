# --- Site -------------------------------------------------------------------
# Public base URL, no trailing slash. Used for canonicals, sitemap and og images.
# Source: your own domain (prod: https://startaegetforetag.se; preview: the Hostinger slot URL).
SITE_URL="http://localhost:3000"

# --- Database (Hostinger MySQL) --------------------------------------------
# Source: Hostinger hPanel > Databases > MySQL. Remote MySQL must whitelist the
# app host before a remote connection works. Leave empty locally: the app then
# skips every DB write and logs instead of crashing.
DATABASE_URL=""

# --- VenderCRM (lead forwarding) -------------------------------------------
# Source: VenderCRM > Sitios > this site. The key is shown once; one key per site.
# Unset = leads are stored in the local `leads` table only, never lost.
VENDERCRM_URL=""
VENDERCRM_API_KEY=""

# --- E-mail (newsletter + e-mail-my-result) --------------------------------
# Source: resend.com > API keys. Unset = subscriber row is stored, no mail sent.
RESEND_API_KEY=""
RESEND_FROM="Starta Eget Företag <noreply@startaegetforetag.se>"

# --- Optional ---------------------------------------------------------------
# Google Search Console HTML-tag verification token (the content= value only).
GOOGLE_SITE_VERIFICATION=""

# --- Admin (/admin/, plan §5.5 + §7 punkt 10–12) ---------------------------
# The one password for the blog admin. Source: pick it yourself, store it in
# hPanel > Node.js app > Environment variables. Unset = nobody can log in (the
# login screen says so); the public site is unaffected.
ADMIN_PASSWORD=""
# 32+ random characters, used to sign the session cookie (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# --- GitHub (the admin's storage backend) -----------------------------------
# A fine-grained token with *Contents: read and write* on this repository only.
# Source: github.com > Settings > Developer settings > Fine-grained tokens.
# Set = /admin/ reads and commits through the GitHub API and Hostinger rebuilds
# on push. Unset = the admin falls back to writing content/ on local disk, which
# is what dev uses and what a production slot without a token gets (read-mostly:
# the write survives only until the next deploy).
GITHUB_TOKEN=""
GITHUB_REPO="antonmarklundcom/startaeget"
GITHUB_BRANCH="main"

# The commit the running build was made from. Written at build time (Hostinger:
# add `NEXT_PUBLIC_BUILD_SHA=$(git rev-parse HEAD)` to the build command, or set
# it in hPanel after each deploy). Used only by /admin/ to tell a saved file from
# a live one; unset = the admin says the build state is unknown instead of guessing.
NEXT_PUBLIC_BUILD_SHA=""
